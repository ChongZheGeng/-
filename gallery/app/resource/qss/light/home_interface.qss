SettingInterface,
#view {
    background-color: transparent;
}

QScrollArea {
    border: none;
    background-color: transparent;
}


BannerWidget > #galleryLabel {
    font: 42px 'Segoe UI SemiBold', 'Microsoft YaHei SemiBold';
    background-color: transparent;
    color: black;
    padding-left: 28px;
}




#sensorDataOverviewWidget {
    background-color: transparent;
    border: 1px solid rgba(120, 120, 120, 45);
    border-radius: 10px;
}

#sensorChartCard,
#sensorStatCard {
    border-radius: 8px;
}
